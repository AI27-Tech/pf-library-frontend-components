#!/usr/bin/env sh

# Lint sobre lo staged y typecheck del proyecto completo.
#
# El typecheck va completo a proposito: un cambio de tipo en un componente rompe a
# consumidores que no estan en el commit, y lint-staged no los veria.
#
# NO se introduce prettier en la libreria por ahora (no estaba en devDeps y
# reformatearia archivos existentes); queda como decision abierta en el spec E8-T1.
#
# NO se invoca ningun gestor de paquetes aqui. Husky pone node_modules/.bin al frente
# del PATH, asi que los binarios locales se resuelven solos.

if [ ! -d node_modules ]; then
  echo "pre-commit: falta node_modules. Instala las dependencias antes de commitear." >&2
  exit 1
fi

lint-staged || exit 1
tsc -b || exit 1
